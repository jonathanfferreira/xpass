*.env
*.env.local
*.env.development.local
*.env.test.local
*.env.production.local
.env*
secrets/
**/serviceAccountKey.json
**/firebase-adminsdk*.json
**/*-credentials.json

functions/.runtimeconfig.json

# ==========================================
# 📦 Dependencies
# ==========================================
node_modules/
**/node_modules/

# ==========================================
